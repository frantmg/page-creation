# ── Kit working files ──────────────────────────────
node_modules/
dist/
clients/
work/
*.png
*-rendered.html
.DS_Store

# PUBLIC REPO: never commit credentials, tokens, or personal data.

# ── Claude / agent config that can hold secrets ─────
# MCP server configs often contain API keys or auth headers.
# Commit a sanitized .mcp.example.json instead.
.mcp.json
mcp.json
*.mcp.json
!*.mcp.example.json
.claude/settings.local.json
.claude/*.local.*
.claude/.credentials.json
.claude/credentials*
.claude/todos/
.claude/projects/
.claude/statsig/
.claude/shell-snapshots/
CLAUDE.local.md
*.local.md
# Session transcripts / logs can contain pasted secrets
*.jsonl
transcripts/
sessions/

# ── Any env / secret files (in case they appear) ────
.env
.env.*
!.env.example
*.local
.secrets/
secrets.*
credentials.json
*-credentials.json
service-account*.json
token.json
*.token

# Keys & certificates
*.pem
*.key
*.p12
*.pfx
*.ppk
id_rsa*
id_ed25519*

# Tool auth files
.npmrc
.netrc
.pypirc
.aws/
.gcloud/
.vercel/

